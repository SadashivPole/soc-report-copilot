# ============ Backend configuration ============
NODE_ENV=development
PORT=3000

# PostgreSQL connection
# Docker Compose uses DB_USER / DB_PASSWORD / DB_NAME to build DATABASE_URL.
DB_USER=soc
DB_PASSWORD=socpass
DB_NAME=soc_copilot
DATABASE_URL=postgres://soc:socpass@localhost:5432/soc_copilot

# ---- Auth (PRODUCTION HARDENING) ----
# JWT_SECRET is MANDATORY in production (NODE_ENV=production): the app refuses to
# start with a missing/short/default secret. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- CORS (PRODUCTION HARDENING) ----
# Comma-separated list of allowed browser origins.
#   development: may be '*' or empty (permissive) — the SPA is same-origin anyway.
#   production : MUST be an explicit list. '*' or empty is REFUSED at startup.
# Example (production):
#   CORS_ORIGIN=https://soc.yourdomain.com,https://portal.yourdomain.com
CORS_ORIGIN=*

# Public base URL used to build share links (optional; falls back to request host)
APP_BASE_URL=

# Demo mode exposes seed-login hints in the UI and permits the demo seeder.
# Automatically OFF when NODE_ENV=production unless you set DEMO_MODE=true.
DEMO_MODE=

# Default plan assigned to a new tenant on signup: free | pro | mssp
DEFAULT_PLAN=pro

# ---- Upload safety limits (untrusted input hardening) ----
MAX_UPLOAD_BYTES=26214400
MAX_EVENTS=50000
MAX_LOGO_BYTES=262144

# ---- Analysis provider: 'deterministic' (default, no external calls) or 'openai' ----
ANALYSIS_PROVIDER=deterministic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Scheduled report email delivery ----
# If SMTP_URL is unset, scheduled emails are recorded in the email_outbox table
# (auditable/testable) instead of being sent. Set to enable real delivery.
MAIL_FROM=SOC Report Copilot <no-reply@soc-copilot.local>
SMTP_URL=
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=60000

# ---- Data retention (M3) ----
# The retention WINDOW is driven by the tenant's plan (free=30d, pro=180d, mssp=730d).
# A background sweep deletes uploads/events/reports older than the window; management
# actions and audit logs are preserved. Set RETENTION_ENABLED=false to disable the
# automatic sweep (manual enforcement is still available to admins via the API).
RETENTION_ENABLED=true
RETENTION_SWEEP_INTERVAL_MS=86400000
